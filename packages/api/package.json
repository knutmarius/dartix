{
  "name": "@dartix/api",
  "version": "0.0.0",
  "private": true,
  "description": "Thin Express API over the existing DartiX MongoDB collections",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "verify:history": "tsx src/scripts/verify-history.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dartix/core": "*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
