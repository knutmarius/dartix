# Copy to .env and fill in. .env is gitignored; never commit real values.

# The Atlas connection string for the dartix-app database user.
# readWrite on the DartiX database only — not the cluster admin account.
# Percent-encode any symbols in the password: @ -> %40, # -> %23, / -> %2F
MONGODB_URI=mongodb+srv://dartix-app:PASSWORD@cluster0-xxxxx.mongodb.net/?retryWrites=true&w=majority

# The database and collection names the 2011 app created. Do not change these
# unless you have migrated the data — the old app reads the same collections.
MONGODB_DB=DartiX

# The shared passcode the login screen exchanges for a signed cookie.
APP_PASSCODE=change-me

# Optional. A second passcode that can see everything but change nothing:
# no saving games, no deleting games, no adding or removing players. Leave it
# unset to turn the read-only role off entirely. Must differ from APP_PASSCODE.
APP_PASSCODE_READONLY=

# Secret used to sign the session cookie. Any long random string.
SESSION_SECRET=change-me

PORT=3000
